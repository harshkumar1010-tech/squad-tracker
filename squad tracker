<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Squad Python Tracker</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,600;9..144,700&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@500;600&display=swap" rel="stylesheet">
<style>
  :root{
    --bg:#EDF1F7;
    --bg-card:#FFFFFF;
    --ink:#202A3C;
    --ink-soft:#5B6478;
    --line:#D7DEE9;
    --blue:#2F5D8A;
    --mustard:#E8A33D;
    --coral:#E1604F;
    --teal:#3E8E7E;
    --radius:14px;
  }
  *{box-sizing:border-box;}
  body{
    margin:0;
    background:var(--bg);
    color:var(--ink);
    font-family:'Inter',sans-serif;
    -webkit-font-smoothing:antialiased;
  }
  .wrap{
    max-width:920px;
    margin:0 auto;
    padding:40px 20px 80px;
  }

  /* ---------- Header ---------- */
  header{
    display:flex;
    flex-wrap:wrap;
    align-items:flex-end;
    justify-content:space-between;
    gap:20px;
    margin-bottom:36px;
  }
  h1{
    font-family:'Fraunces',serif;
    font-weight:600;
    font-size:clamp(32px,5vw,44px);
    line-height:1.05;
    margin:0 0 6px;
    letter-spacing:-0.01em;
  }
  header p{
    margin:0;
    color:var(--ink-soft);
    font-size:15px;
    max-width:380px;
  }
  .squad-energy{
    text-align:right;
  }
  .squad-energy .num{
    font-family:'Fraunces',serif;
    font-weight:700;
    font-size:40px;
    color:var(--mustard);
    line-height:1;
  }
  .squad-energy .lbl{
    font-size:13px;
    color:var(--ink-soft);
    margin-top:4px;
  }

  /* ---------- Trail ---------- */
  .trail-section{
    background:var(--bg-card);
    border:1px solid var(--line);
    border-radius:var(--radius);
    padding:28px 24px 20px;
    margin-bottom:28px;
  }
  .trail-section h2{
    font-family:'Fraunces',serif;
    font-weight:600;
    font-size:18px;
    margin:0 0 26px;
  }
  .trail{
    position:relative;
    height:96px;
    margin:0 8px 8px;
  }
  .trail-line{
    position:absolute;
    top:44px;
    left:0;
    right:0;
    height:3px;
    background:var(--line);
    border-radius:2px;
  }
  .trail-fill{
    position:absolute;
    top:44px;
    left:0;
    height:3px;
    background:linear-gradient(90deg,var(--blue),var(--teal));
    border-radius:2px;
    transition:width .6s ease;
  }
  .tick{
    position:absolute;
    top:38px;
    width:2px;
    height:15px;
    background:var(--line);
    transform:translateX(-50%);
  }
  .tick-label-start,.tick-label-end{
    position:absolute;
    top:60px;
    font-size:11px;
    color:var(--ink-soft);
    font-family:'JetBrains Mono',monospace;
  }
  .tick-label-start{left:0;}
  .tick-label-end{right:0;transform:translateX(0);}
  .avatar-pin{
    position:absolute;
    top:44px;
    transform:translate(-50%,-50%);
    display:flex;
    flex-direction:column;
    align-items:center;
    gap:6px;
    transition:left .6s ease;
  }
  .avatar-pin .bubble{
    width:38px;
    height:38px;
    border-radius:50%;
    display:flex;
    align-items:center;
    justify-content:center;
    font-size:18px;
    background:#fff;
    border:2.5px solid var(--blue);
    box-shadow:0 2px 6px rgba(32,42,60,0.12);
  }
  .avatar-pin .pin-name{
    font-size:11px;
    font-weight:600;
    color:var(--ink);
    white-space:nowrap;
    background:var(--bg-card);
    padding:1px 6px;
    border-radius:20px;
  }

  /* ---------- Friend cards ---------- */
  .grid{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:16px;
  }
  @media (max-width:640px){ .grid{grid-template-columns:1fr;} }

  .card{
    background:var(--bg-card);
    border:1px solid var(--line);
    border-radius:var(--radius);
    padding:18px 18px 16px;
    border-left:4px solid var(--accent,var(--blue));
    display:flex;
    flex-direction:column;
    gap:10px;
  }
  .card.is-me{
    box-shadow:0 0 0 2px var(--accent,var(--blue)) inset;
  }
  .card-top{
    display:flex;
    align-items:center;
    gap:10px;
  }
  .card-avatar{
    width:34px;height:34px;
    border-radius:50%;
    background:var(--bg);
    display:flex;align-items:center;justify-content:center;
    font-size:17px;
    flex-shrink:0;
  }
  .card-name{
    font-weight:600;
    font-size:15px;
    outline:none;
    border-bottom:1px dashed transparent;
  }
  .card-name[contenteditable="true"]:hover{
    border-bottom:1px dashed var(--ink-soft);
    cursor:text;
  }
  .you-tag{
    font-size:10px;
    font-family:'JetBrains Mono',monospace;
    color:var(--accent,var(--blue));
    border:1px solid var(--accent,var(--blue));
    border-radius:20px;
    padding:1px 7px;
    margin-left:auto;
  }
  .milestone-tag{
    font-family:'JetBrains Mono',monospace;
    font-size:12px;
    color:var(--ink-soft);
  }
  .bar-track{
    height:6px;
    background:var(--bg);
    border-radius:4px;
    overflow:hidden;
  }
  .bar-fill{
    height:100%;
    background:var(--accent,var(--blue));
    border-radius:4px;
    transition:width .5s ease;
  }
  .streak{
    font-size:13px;
    color:var(--ink-soft);
  }
  .streak b{color:var(--ink);}
  .note{
    font-size:13px;
    color:var(--ink);
    background:var(--bg);
    border-radius:8px;
    padding:8px 10px;
    line-height:1.4;
    min-height:18px;
  }
  .note .updated{
    display:block;
    font-size:10.5px;
    color:var(--ink-soft);
    margin-top:4px;
    font-family:'JetBrains Mono',monospace;
  }
  .card-actions{
    display:flex;
    align-items:center;
    gap:8px;
    margin-top:2px;
    flex-wrap:wrap;
  }
  .cheer-btn{
    border:1px solid var(--line);
    background:#fff;
    border-radius:20px;
    padding:4px 9px;
    font-size:13px;
    cursor:pointer;
    display:flex;
    align-items:center;
    gap:4px;
    transition:transform .15s ease, background .15s ease;
  }
  .cheer-btn:hover{background:var(--bg);}
  .cheer-btn.pop{transform:scale(1.18);}
  .cheer-count{
    font-family:'JetBrains Mono',monospace;
    font-size:11px;
    color:var(--ink-soft);
  }
  .log-btn{
    margin-left:auto;
    background:var(--accent,var(--blue));
    color:#fff;
    border:none;
    border-radius:20px;
    padding:7px 14px;
    font-size:13px;
    font-weight:600;
    cursor:pointer;
    font-family:'Inter',sans-serif;
  }
  .log-btn:hover{filter:brightness(1.08);}

  /* ---------- Onboarding & modal ---------- */
  .overlay{
    position:fixed;inset:0;
    background:rgba(32,42,60,0.45);
    display:flex;align-items:center;justify-content:center;
    padding:20px;
    z-index:20;
  }
  .sheet{
    background:var(--bg-card);
    border-radius:18px;
    padding:28px 26px;
    max-width:420px;
    width:100%;
  }
  .sheet h2{
    font-family:'Fraunces',serif;
    font-size:22px;
    margin:0 0 6px;
  }
  .sheet p{
    color:var(--ink-soft);
    font-size:14px;
    margin:0 0 20px;
  }
  .pick-list{
    display:flex;
    flex-direction:column;
    gap:8px;
    margin-bottom:6px;
  }
  .pick-item{
    display:flex;
    align-items:center;
    gap:10px;
    border:1.5px solid var(--line);
    border-radius:10px;
    padding:10px 12px;
    cursor:pointer;
    background:#fff;
    font-family:'Inter',sans-serif;
    font-size:14px;
    font-weight:600;
    color:var(--ink);
  }
  .pick-item:hover{border-color:var(--blue);}
  .pick-item .em{font-size:18px;}

  .field-label{
    font-size:12px;
    font-weight:600;
    color:var(--ink-soft);
    margin:14px 0 6px;
    display:block;
  }
  select, textarea, input[type="number"]{
    width:100%;
    border:1.5px solid var(--line);
    border-radius:8px;
    padding:9px 10px;
    font-family:'Inter',sans-serif;
    font-size:14px;
    color:var(--ink);
    background:#fff;
  }
  textarea{resize:vertical;min-height:64px;}
  .modal-actions{
    display:flex;
    justify-content:flex-end;
    gap:10px;
    margin-top:20px;
  }
  .btn-ghost{
    background:none;
    border:none;
    color:var(--ink-soft);
    font-size:14px;
    cursor:pointer;
    padding:8px 10px;
  }
  .btn-primary{
    background:var(--blue);
    color:#fff;
    border:none;
    border-radius:20px;
    padding:9px 18px;
    font-size:14px;
    font-weight:600;
    cursor:pointer;
  }

  footer{
    text-align:center;
    margin-top:30px;
  }
  footer button{
    background:none;
    border:none;
    color:var(--ink-soft);
    font-size:12.5px;
    text-decoration:underline;
    cursor:pointer;
  }
  .loading-line{
    color:var(--ink-soft);
    font-size:14px;
    padding:40px 0;
    text-align:center;
  }
  .hidden{display:none !important;}
</style>
</head>
<body>

<div class="wrap">
  <header>
    <div>
      <h1>Squad Python Tracker</h1>
      <p>No one's ahead. No one's behind. Just four people getting a little better at Python every day.</p>
    </div>
    <div class="squad-energy">
      <div class="num" id="squadStreak">–</div>
      <div class="lbl">combined streak days</div>
    </div>
  </header>

  <section class="trail-section">
    <h2>The trail</h2>
    <div class="trail" id="trail">
      <div class="loading-line">Loading the squad's trail…</div>
    </div>
  </section>

  <div class="grid" id="cardsGrid">
    <div class="loading-line">Pulling everyone's progress…</div>
  </div>

  <footer>
    <button id="switchProfileBtn">Not you? Switch profile</button>
  </footer>
</div>

<!-- Onboarding overlay -->
<div class="overlay hidden" id="onboardOverlay">
  <div class="sheet">
    <h2>Who's this?</h2>
    <p>Pick your name so the squad knows whose progress is whose.</p>
    <div class="pick-list" id="pickList"></div>
  </div>
</div>

<!-- Log update modal -->
<div class="overlay hidden" id="logOverlay">
  <div class="sheet">
    <h2>Log your progress</h2>
    <p id="logSubtitle">Update where you're at — the squad will see it right away.</p>

    <label class="field-label" for="milestoneSelect">Where are you now?</label>
    <select id="milestoneSelect"></select>

    <label class="field-label" for="streakInput">Current streak (days)</label>
    <input type="number" id="streakInput" min="0" step="1">

    <label class="field-label" for="noteInput">Quick note for the squad</label>
    <textarea id="noteInput" placeholder="e.g. Finally got recursion to click 🎉"></textarea>

    <div class="modal-actions">
      <button class="btn-ghost" id="cancelLog">Cancel</button>
      <button class="btn-primary" id="saveLog">Save update</button>
    </div>
  </div>
</div>

<script>
const MILESTONES = [
  "Not started",
  "Setup & syntax",
  "Variables & types",
  "Control flow",
  "Loops",
  "Functions",
  "Lists & dicts",
  "File handling",
  "OOP basics",
  "Error handling",
  "Mini project"
];

const DEFAULT_MEMBERS = [
  { id:"f1", name:"Krish",   emoji:"🦊", accent:"#2F5D8A" },
  { id:"f2", name:"Harsh",    emoji:"🐢", accent:"#E1604F" },
  { id:"f3", name:"Rudra", emoji:"🐼", accent:"#E8A33D" },
  { id:"f4", name:"Kshitiz",  emoji:"🦁", accent:"#3E8E7E" }
];

let members = [];
let progress = {};   // id -> {milestone, streak, note, updatedAt}
let cheers = {};      // id -> {clap, fire, hundred}
let meId = null;

async function safeGet(key, shared){
  try{
    const r = await window.storage.get(key, shared);
    return r ? r.value : null;
  }catch(e){
    return null;
  }
}
async function safeSet(key, value, shared){
  try{
    return await window.storage.set(key, JSON.stringify(value), shared);
  }catch(e){
    console.error("storage set failed", key, e);
    return null;
  }
}

function timeAgo(iso){
  if(!iso) return "no update yet";
  const diff = Date.now() - new Date(iso).getTime();
  const mins = Math.floor(diff/60000);
  if(mins < 1) return "just now";
  if(mins < 60) return mins+"m ago";
  const hrs = Math.floor(mins/60);
  if(hrs < 24) return hrs+"h ago";
  const days = Math.floor(hrs/24);
  return days+"d ago";
}

async function loadAll(){
  // members
  let raw = await safeGet("members", true);
  if(raw){
    try{ members = JSON.parse(raw); }catch(e){ members = DEFAULT_MEMBERS; }
  } else {
    members = DEFAULT_MEMBERS;
    await safeSet("members", members, true);
  }

  // progress + cheers per member
  await Promise.all(members.map(async(m)=>{
    let p = await safeGet("progress:"+m.id, true);
    progress[m.id] = p ? JSON.parse(p) : { milestone:0, streak:0, note:"", updatedAt:null };

    let c = await safeGet("cheers:"+m.id, true);
    cheers[m.id] = c ? JSON.parse(c) : { clap:0, fire:0, hundred:0 };
  }));

  // personal identity
  meId = await safeGet("me", false);
}

function renderTrail(){
  const trail = document.getElementById("trail");
  trail.innerHTML = "";

  const line = document.createElement("div");
  line.className = "trail-line";
  trail.appendChild(line);

  const maxM = MILESTONES.length - 1;
  const avgMilestone = members.reduce((s,m)=> s + (progress[m.id].milestone||0), 0) / members.length;
  const fill = document.createElement("div");
  fill.className = "trail-fill";
  fill.style.width = (avgMilestone/maxM*100)+"%";
  trail.appendChild(fill);

  for(let i=0;i<=maxM;i++){
    const t = document.createElement("div");
    t.className = "tick";
    t.style.left = (i/maxM*100)+"%";
    trail.appendChild(t);
  }
  const startLbl = document.createElement("div");
  startLbl.className = "tick-label-start";
  startLbl.textContent = "start";
  trail.appendChild(startLbl);
  const endLbl = document.createElement("div");
  endLbl.className = "tick-label-end";
  endLbl.textContent = "mini project";
  trail.appendChild(endLbl);

  // group by milestone to offset overlapping pins slightly
  const byMilestone = {};
  members.forEach(m=>{
    const ms = progress[m.id].milestone || 0;
    byMilestone[ms] = byMilestone[ms] || [];
    byMilestone[ms].push(m);
  });

  Object.keys(byMilestone).forEach(ms=>{
    const group = byMilestone[ms];
    group.forEach((m, idx)=>{
      const pin = document.createElement("div");
      pin.className = "avatar-pin";
      pin.style.left = (ms/maxM*100)+"%";
      const vOffset = (idx - (group.length-1)/2) * 14;
      pin.style.marginTop = vOffset+"px";
      pin.innerHTML = `
        <div class="bubble" style="border-color:${m.accent}">${m.emoji}</div>
        <div class="pin-name">${escapeHtml(m.name)}</div>
      `;
      trail.appendChild(pin);
    });
  });
}

function escapeHtml(str){
  const d = document.createElement("div");
  d.textContent = str;
  return d.innerHTML;
}

function renderSquadStreak(){
  const total = members.reduce((s,m)=> s + (progress[m.id].streak||0), 0);
  document.getElementById("squadStreak").textContent = total;
}

function renderCards(){
  const grid = document.getElementById("cardsGrid");
  grid.innerHTML = "";

  members.forEach(m=>{
    const p = progress[m.id];
    const c = cheers[m.id];
    const isMe = m.id === meId;
    const card = document.createElement("div");
    card.className = "card" + (isMe ? " is-me" : "");
    card.style.setProperty("--accent", m.accent);

    card.innerHTML = `
      <div class="card-top">
        <div class="card-avatar">${m.emoji}</div>
        <div class="card-name" contenteditable="${isMe}" data-id="${m.id}">${escapeHtml(m.name)}</div>
        ${isMe ? '<span class="you-tag">you</span>' : ''}
      </div>
      <div class="milestone-tag">${MILESTONES[p.milestone||0]}</div>
      <div class="bar-track"><div class="bar-fill" style="width:${(p.milestone||0)/(MILESTONES.length-1)*100}%"></div></div>
      <div class="streak">🔥 <b>${p.streak||0}</b> day streak</div>
      <div class="note">${p.note ? escapeHtml(p.note) : "No note yet — say hi 👋"}<span class="updated">${timeAgo(p.updatedAt)}</span></div>
      <div class="card-actions">
        <button class="cheer-btn" data-id="${m.id}" data-type="clap">👏 <span class="cheer-count">${c.clap}</span></button>
        <button class="cheer-btn" data-id="${m.id}" data-type="fire">🔥 <span class="cheer-count">${c.fire}</span></button>
        <button class="cheer-btn" data-id="${m.id}" data-type="hundred">💯 <span class="cheer-count">${c.hundred}</span></button>
        ${isMe ? `<button class="log-btn" data-id="${m.id}">Log progress</button>` : ''}
      </div>
    `;
    grid.appendChild(card);
  });

  // wire up cheer buttons
  grid.querySelectorAll(".cheer-btn").forEach(btn=>{
    btn.addEventListener("click", ()=> handleCheer(btn));
  });
  // wire up log buttons
  grid.querySelectorAll(".log-btn").forEach(btn=>{
    btn.addEventListener("click", ()=> openLogModal(btn.dataset.id));
  });
  // wire up name editing
  grid.querySelectorAll(".card-name[contenteditable='true']").forEach(el=>{
    el.addEventListener("blur", ()=> saveNameEdit(el));
    el.addEventListener("keydown", (e)=>{
      if(e.key === "Enter"){ e.preventDefault(); el.blur(); }
    });
  });
}

async function saveNameEdit(el){
  const id = el.dataset.id;
  const newName = el.textContent.trim();
  const m = members.find(x=>x.id===id);
  if(!m || !newName || newName === m.name) { el.textContent = m.name; return; }
  m.name = newName;
  await safeSet("members", members, true);
  renderTrail();
}

async function handleCheer(btn){
  const id = btn.dataset.id;
  const type = btn.dataset.type;
  cheers[id][type] = (cheers[id][type]||0) + 1;
  btn.classList.add("pop");
  setTimeout(()=> btn.classList.remove("pop"), 180);
  btn.querySelector(".cheer-count").textContent = cheers[id][type];
  await safeSet("cheers:"+id, cheers[id], true);
}

function openLogModal(id){
  const m = members.find(x=>x.id===id);
  const p = progress[id];
  document.getElementById("logSubtitle").textContent = `Update where you're at, ${m.name} — the squad will see it right away.`;

  const sel = document.getElementById("milestoneSelect");
  sel.innerHTML = MILESTONES.map((label,i)=>`<option value="${i}" ${i===p.milestone?'selected':''}>${label}</option>`).join("");

  document.getElementById("streakInput").value = p.streak || 0;
  document.getElementById("noteInput").value = p.note || "";

  document.getElementById("logOverlay").classList.remove("hidden");
  document.getElementById("saveLog").onclick = ()=> saveLog(id);
}

async function saveLog(id){
  const milestone = parseInt(document.getElementById("milestoneSelect").value, 10);
  const streak = Math.max(0, parseInt(document.getElementById("streakInput").value || "0", 10));
  const note = document.getElementById("noteInput").value.trim();

  progress[id] = { milestone, streak, note, updatedAt: new Date().toISOString() };
  await safeSet("progress:"+id, progress[id], true);

  document.getElementById("logOverlay").classList.add("hidden");
  renderTrail();
  renderSquadStreak();
  renderCards();
}
document.getElementById("cancelLog").addEventListener("click", ()=>{
  document.getElementById("logOverlay").classList.add("hidden");
});

function openOnboarding(){
  const list = document.getElementById("pickList");
  list.innerHTML = members.map(m=>`
    <div class="pick-item" data-id="${m.id}">
      <span class="em">${m.emoji}</span> ${escapeHtml(m.name)}
    </div>
  `).join("");
  list.querySelectorAll(".pick-item").forEach(item=>{
    item.addEventListener("click", async ()=>{
      meId = item.dataset.id;
      await safeSet("me", meId, false);
      document.getElementById("onboardOverlay").classList.add("hidden");
      renderCards();
    });
  });
  document.getElementById("onboardOverlay").classList.remove("hidden");
}

document.getElementById("switchProfileBtn").addEventListener("click", ()=>{
  openOnboarding();
});

async function init(){
  await loadAll();
  renderTrail();
  renderSquadStreak();
  renderCards();
  if(!meId || !members.find(m=>m.id===meId)){
    openOnboarding();
  }
}

init();
</script>

</body>
</html>
